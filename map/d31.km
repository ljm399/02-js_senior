{"root":{"data":{"id":"d2vtobxolvs0","created":1721626544394,"text":"浏览器运行原理"},"children":[{"data":{"id":"d2vtoz2jmu00","created":1721626594754,"text":"其他视频的精通css可以看,但之后自己学完英语去官网补充"},"children":[]},{"data":{"id":"d2vtpn4v5d40","created":1721626647137,"text":"url","priority":1},"children":[{"data":{"id":"d2vtpq3xrh40","created":1721626653612,"text":"DNS解析为16位"},"children":[{"data":{"id":"d2vtq0vec4w0","created":1721626677040,"text":"服务器对应资源"},"children":[{"data":{"id":"d2vtqfbhtaw0","created":1721626708488,"text":"返回index.html"},"children":[{"data":{"id":"d2vtqm8ujwo0","created":1721626723566,"text":"遇到css/html文件就下载相对应文件"},"children":[]},{"data":{"id":"d2vtw11gja80","created":1721627147591,"text":"遇到Js文件就下载(有分支,因为有不同的内核)"},"children":[]}]}]}]}]},{"data":{"id":"d2vtqpfgldk0","created":1721626730496,"text":"解析","priority":2},"children":[{"data":{"id":"d2vtquqakn40","created":1721626742035,"text":"Dom tree 和 cssom(css object  model css对象模型)"},"children":[{"data":{"id":"d2vtrf1acjk0","created":1721626786235,"text":"当有上面就合成render(渲染,提供) tree"},"children":[{"data":{"id":"d2vu1l09vyg0","created":1721627582876,"text":"render tree合成不受link阻塞"},"children":[]},{"data":{"id":"d2vu1x5dd680","created":1721627609306,"text":"render tree和dom tree不是一一对应的,如display为none不会出现在render tree中"},"children":[]}]}]}]},{"data":{"id":"d2wkoa5lp480","created":1721702710487,"text":"js文件","priority":3},"children":[{"data":{"id":"d2wkompoguo0","created":1721702737823,"text":"内核"},"children":[{"data":{"id":"d2wkx85khjc0","created":1721703411409,"text":"以webkit为例"},"children":[{"data":{"id":"d2wkxf0trig0","created":1721703426360,"text":"web负责html的解析"},"children":[]},{"data":{"id":"d2wkxp7c4r40","created":1721703448521,"text":"JavaScriptCore负责解析js代码"},"children":[]}]},{"data":{"id":"d2wkzp4sgag0","created":1721703605097,"text":"另一个JavaScript引擎就是V8引擎"},"children":[]}]},{"data":{"id":"d2wkoqbz0800","created":1721702745701,"text":"不像css,而是解析完再下个"},"children":[{"data":{"id":"d2wkpjc3nu00","created":1721702808835,"text":"为其有,故有两个属性"},"children":[{"data":{"id":"d2wkpruhyew0","created":1721702827362,"text":"defer("},"children":[{"data":{"id":"d2wkpyxi3w00","created":1721702842781,"text":"遇到像css那样,但在所有资源加载完成(DomComtentLoaded)\\之前"},"children":[]},{"data":{"id":"d2wkspezvnk0","created":1721703057164,"text":"建议放到head中,和css一样"},"children":[]},{"data":{"id":"d2wksy8mpdc0","created":1721703076370,"text":"外部script,内部会忽略"},"children":[]}]},{"data":{"id":"d2wkpvnwmgo0","created":1721702835671,"text":"synas"},"children":[{"data":{"id":"d2wkqrs3l600","created":1721702905581,"text":"完全独立,且有这个属性,不安其顺序"},"children":[{"data":{"id":"d2wkrn1b4bk0","created":1721702973618,"text":"适用于与DOM没交集的js"},"children":[]}]}]}]}]},{"data":{"id":"d2wl0ttomxs0","created":1721703693672,"text":"过程"},"children":[{"data":{"id":"d2wl0xsvzg00","created":1721703702331,"text":"js源代码"},"children":[{"data":{"id":"d2wl13i1ezs0","created":1721703714736,"text":"parse(解析)为AST(抽象语法树,把关键字放一起)"},"children":[{"data":{"id":"d2wl1hwrxps0","created":1721703746102,"text":"ignition(sum(10,20)),第二个sum(20,30),第三个sum('1','2')"},"children":[{"data":{"id":"d2wl1m83its0","created":1721703755494,"text":"bytecode(sum(10,20)"},"children":[{"data":{"id":"d2wl1ovvct40","created":1721703761285,"text":"结果"},"children":[]},{"data":{"id":"d2wl47jt7ps0","created":1721703958643,"text":"TurboFan","priority":1},"children":[{"data":{"id":"d2wl1w4vako0","created":1721703777066,"text":"MachineCode","layout_right_offset":{"x":23,"y":2}},"children":[{"data":{"id":"d2wl1zpjbjc0","created":1721703784846,"text":"结果"},"children":[]},{"data":{"id":"d2wl2dmsetc0","created":1721703815155,"text":"Deoptimization"},"children":[{"data":{"id":"d2wl2im88rc0","created":1721703826005,"text":"bytecode(解析为计算机可以看出来的)"},"children":[{"data":{"id":"d2wl2l0j5ww0","created":1721703831223,"text":"结果(sum('1','2')"},"children":[]}]}]}]}]}]},{"data":{"id":"d2wl1t2jbs00","created":1721703770395,"text":"turboFan(sum(20,30)","priority":2},"children":[{"data":{"id":"d2wl1w4vako0","created":1721703777066,"text":"MachineCode","layout_right_offset":{"x":23,"y":2}},"children":[{"data":{"id":"d2wl1zpjbjc0","created":1721703784846,"text":"结果(sum(20,30)"},"children":[]},{"data":{"id":"d2wl2dmsetc0","created":1721703815155,"text":"Deoptimization(当结果是sum('1','2')才有这步"},"children":[{"data":{"id":"d2wl2im88rc0","created":1721703826005,"text":"bytecode(解析为计算机可以看出来的)"},"children":[{"data":{"id":"d2wl2l0j5ww0","created":1721703831223,"text":"结果"},"children":[]}]}]}]},{"data":{"id":"d2wl8rp2f5k0","created":1721704315953,"text":"作用:收集如同sum(20,30)这样的数据,方便优化性能(即当函数是多次调用的热点函数)"},"children":[]}]},{"data":{"id":"d2wl8e1sas00","created":1721704286247,"text":"作用:将js代码转为二进制代码"},"children":[]}]},{"data":{"id":"d2wl7t4i65s0","created":1721704240699,"text":"因为解释器不会认识js代码"},"children":[]}]}]}]}]},{"data":{"id":"d2vu3tr8k3c0","created":1721627758649,"text":"render tree的下一步","priority":3},"children":[{"data":{"id":"d2vu44t01dk0","created":1721627782700,"text":"computestyle"},"children":[{"data":{"id":"d2vu58b0f400","created":1721627868684,"text":"layout(布局)"},"children":[{"data":{"id":"d2vu5bcindk0","created":1721627875305,"text":"painting(绘制,如color)"},"children":[{"data":{"id":"d2vu5qveihs0","created":1721627909099,"text":"composite(多层合成)"},"children":[{"data":{"id":"d2vu6x6oa9s0","created":1721628001205,"text":"形成多层的方法有"},"children":[{"data":{"id":"d2vu7d76dts0","created":1721628036064,"text":"1,position:fixed(absolute不行)"},"children":[]},{"data":{"id":"d2vu7p7aotc0","created":1721628062193,"text":"2,transition是opacity或transform"},"children":[]},{"data":{"id":"d2vu8arunio0","created":1721628109148,"text":"3,transform:translateZ"},"children":[]},{"data":{"id":"d2vu8ndx2zc0","created":1721628136604,"text":"4,well-change"},"children":[]},{"data":{"id":"d2vybs7buco0","created":1721639666622,"text":"5,video,iframe,canvs"},"children":[]}]}]}]}]}]}]},{"data":{"id":"d2vug2af0v40","created":1721628717593,"text":"回流和重绘(第一次叫绘制)","priority":4,"layout_mind_offset":{"x":-15,"y":45}},"children":[{"data":{"id":"d2vuig9si740","created":1721628904759,"text":"节省性能的方法"},"children":[{"data":{"id":"d2vuo4d9qco0","created":1721629349033,"text":"1,别用computestyle(回流)"},"children":[]},{"data":{"id":"d2vuodfyeq00","created":1721629368786,"text":"2,用分层,这以内存为代价"},"children":[]},{"data":{"id":"d2vuqg07pcw0","created":1721629531093,"text":"3,用类一次性修改属性"},"children":[]}]},{"data":{"id":"d2vur6qv1940","created":1721629589300,"text":"引起回流方法"},"children":[{"data":{"id":"d2vur9ypa7s0","created":1721629596305,"text":"1,窗口大小改变"},"children":[]},{"data":{"id":"d2vv1on7nrc0","created":1721630411903,"text":"2,用computestyle"},"children":[]},{"data":{"id":"d2vv28rzf1k0","created":1721630455728,"text":"3,元素尺寸改变"},"children":[]},{"data":{"id":"d2vv2y2coa80","created":1721630510774,"text":"4,添加或删除新的节点(DOM 结构改变)"},"children":[]}]}]},{"data":{"id":"d2vuc4xdaeo0","created":1721628409878,"text":"目标,责任,计划(明年去深圳或者自己网上自己完成项目(有钱去深圳租房,为第二年毕业留个印象)就不用否则去深圳上班,巅峰自己,一个人),大专毕业就不读了,工作三年","layout_mind_offset":{"x":108,"y":90}},"children":[]}]},"template":"default","theme":"classic-compact","version":"1.4.43"}